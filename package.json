{
  "name": "sda-service-request-tracker",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Full-stack service request approval tracker for Seventh-day Adventist Church hierarchy.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "i18next": "^26.0.10",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.468.0",
    "next": "14.2.35",
    "pdfkit": "^0.18.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.34.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.11.30",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "18.2.67",
    "@types/react-dom": "18.2.22",
    "prisma": "5.22.0",
    "tsx": "4.19.1",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
