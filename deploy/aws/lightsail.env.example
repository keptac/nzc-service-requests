# Public hostname that points to the Lightsail static IP.
APP_DOMAIN=sda-service.example.org

# PostgreSQL runs privately inside Docker on the Lightsail instance.
POSTGRES_DB=sda_service_request
POSTGRES_USER=sda
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Keep false for normal production deploys. Seed CSV files are not copied into Docker images.
RUN_SEED=false

# Required on the first production deploy when the database has no users.
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-admin-password
BOOTSTRAP_ADMIN_NAME=System Administrator

# Optional Twilio WhatsApp support.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token
